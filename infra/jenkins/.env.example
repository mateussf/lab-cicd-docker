# Valores de TESTE, só para o lab local.
JENKINS_ADMIN_PASSWORD=
# Segredo compartilhado entre o webhook do GitLab e os jobs do Jenkins
WEBHOOK_TOKEN=

# Banco "externo" usado pelos apps no deploy (o seu MySQL, no papel do Oracle do ERP)
DB_USER=root
DB_PASSWORD=

# APP_KEY do Laravel em produção (preenchido quando o app3 for criado)
APP3_KEY=
